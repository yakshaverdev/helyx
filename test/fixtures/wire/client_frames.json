{
  "protocol": 4,
  "cases": [
    {"name": "hello with the protocol of the server", "phase": "hello",
     "send": [{"type": "hello", "protocol": 4}],
     "expect": {"frames": [{"type": "welcome", "protocol": 4}]}},
    {"name": "hello with the proof of the token", "phase": "hello", "token": "secret",
     "send": [{"type": "hello", "protocol": 4, "proof": "$proof"}],
     "expect": {"frames": [{"type": "welcome", "protocol": 4}]}},
    {"name": "hello with a wrong proof", "phase": "hello", "token": "secret",
     "send": [{"type": "hello", "protocol": 4, "proof": "AAAA"}],
     "expect": {"close": 4401}},
    {"name": "hello with no proof to a server with a token", "phase": "hello", "token": "secret",
     "send": [{"type": "hello", "protocol": 4}],
     "expect": {"close": 4401}},
    {"name": "hello of another protocol, before its proof", "phase": "hello", "token": "secret",
     "send": [{"type": "hello", "protocol": 3, "proof": "AAAA"}],
     "expect": {"frames": [{"type": "refused", "code": "protocol", "server_protocol": 4}], "close": 4426}},
    {"name": "hello with a protocol that is not an integer", "phase": "hello",
     "send": [{"type": "hello", "protocol": "4"}],
     "expect": {"close": 4400}},
    {"name": "hello with a negative protocol", "phase": "hello",
     "send": [{"type": "hello", "protocol": -1}],
     "expect": {"close": 4400}},
    {"name": "a req before welcome", "phase": "hello",
     "send": [{"type": "req", "id": "1", "op": "sessions.live", "params": {}}],
     "expect": {"close": 4400}},
    {"name": "a part before welcome", "phase": "hello",
     "send": [{"type": "part", "n": 0, "last": true, "data": "e30="}],
     "expect": {"close": 4400}},
    {"name": "a text that is not JSON", "phase": "hello",
     "send": ["{\"type\":"],
     "expect": {"close": 4400}},
    {"name": "a second hello", "phase": "open",
     "send": [{"type": "hello", "protocol": 4}],
     "expect": {"close": 4400}},
    {"name": "a frame of an unknown type", "phase": "open",
     "send": [{"type": "nope"}],
     "expect": {"close": 4400}},

    {"name": "req: an id of 64 bytes", "phase": "open",
     "send": [{"type": "req", "id": "iiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiii", "op": "sessions.live", "params": {}}],
     "expect": {"frames": [{"type": "res", "id": "iiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiii", "ok": true}]}},
    {"name": "req: an id of 65 bytes", "phase": "open",
     "send": [{"type": "req", "id": "iiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiii", "op": "sessions.live", "params": {}}],
     "expect": {"frames": [{"type": "res", "id": "iiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiiii", "ok": false, "error": {"code": "bad_params"}}]}},
    {"name": "req: no readable id", "phase": "open",
     "send": [{"type": "req", "op": "sessions.live", "params": {}}],
     "expect": {"close": 4400}},
    {"name": "req: params that are not an object", "phase": "open",
     "send": [{"type": "req", "id": "1", "op": "sessions.live", "params": []}],
     "expect": {"frames": [{"type": "res", "id": "1", "ok": false, "error": {"code": "bad_params"}}]}},
    {"name": "req: an unknown op", "phase": "open",
     "send": [{"type": "req", "id": "1", "op": "nope", "params": {}}],
     "expect": {"frames": [{"type": "res", "id": "1", "ok": false, "error": {"code": "unknown_op"}}]}},

    {"name": "sessions.live", "phase": "open",
     "send": [{"type": "req", "id": "1", "op": "sessions.live", "params": {}}],
     "expect": {"frames": [{"type": "res", "id": "1", "ok": true, "result": {"sessions": []}}]}},
    {"name": "sessions.live: a key that the op does not name", "phase": "open",
     "send": [{"type": "req", "id": "1", "op": "sessions.live", "params": {"x": 1}}],
     "expect": {"frames": [{"type": "res", "id": "1", "ok": false, "error": {"code": "bad_params"}}]}},
    {"name": "sessions.saved: a limit of 256", "phase": "open",
     "send": [{"type": "req", "id": "1", "op": "sessions.saved", "params": {"limit": 256}}],
     "expect": {"frames": [{"type": "res", "id": "1", "ok": true, "result": {"items": [], "next": null}}]}},
    {"name": "sessions.saved: a limit of 257", "phase": "open",
     "send": [{"type": "req", "id": "1", "op": "sessions.saved", "params": {"limit": 257}}],
     "expect": {"frames": [{"type": "res", "id": "1", "ok": false, "error": {"code": "bad_params"}}]}},
    {"name": "sessions.saved: a limit that is a string", "phase": "open",
     "send": [{"type": "req", "id": "1", "op": "sessions.saved", "params": {"limit": "50"}}],
     "expect": {"frames": [{"type": "res", "id": "1", "ok": false, "error": {"code": "bad_params"}}]}},
    {"name": "start: a cwd with a NUL byte", "phase": "open",
     "send": [{"type": "req", "id": "1", "op": "start", "params": {"cwd": "/a\u0000b", "model": "fake/echo"}}],
     "expect": {"frames": [{"type": "res", "id": "1", "ok": false, "error": {"code": "invalid_cwd"}}]}},
    {"name": "start: no cwd", "phase": "open",
     "send": [{"type": "req", "id": "1", "op": "start", "params": {"model": "fake/echo"}}],
     "expect": {"frames": [{"type": "res", "id": "1", "ok": false, "error": {"code": "bad_params"}}]}},
    {"name": "resume", "phase": "open",
     "send": [{"type": "req", "id": "1", "op": "resume", "params": {"id": "AAAAAAAAAAAA"}}],
     "expect": {"frames": [{"type": "res", "id": "1", "ok": false, "error": {"code": "not_found"}}]}},
    {"name": "resume: both id and cwd", "phase": "open",
     "send": [{"type": "req", "id": "1", "op": "resume", "params": {"id": "missing", "cwd": "/"}}],
     "expect": {"frames": [{"type": "res", "id": "1", "ok": false, "error": {"code": "bad_params"}}]}},
    {"name": "subscribe with a tail", "phase": "open",
     "send": [{"type": "req", "id": "1", "op": "subscribe", "params": {"session": "missing", "tail": 1000, "answers": true}}],
     "expect": {"frames": [{"type": "res", "id": "1", "ok": false, "error": {"code": "session_not_found"}}]}},
    {"name": "subscribe: a tail that is a string", "phase": "open",
     "send": [{"type": "req", "id": "1", "op": "subscribe", "params": {"session": "missing", "tail": "200"}}],
     "expect": {"frames": [{"type": "res", "id": "1", "ok": false, "error": {"code": "bad_params"}}]}},
    {"name": "subscribe with after", "phase": "open",
     "send": [{"type": "req", "id": "1", "op": "subscribe", "params": {"session": "missing", "after": {"instance_id": "i1", "seq": 4}}}],
     "expect": {"frames": [{"type": "res", "id": "1", "ok": false, "error": {"code": "session_not_found"}}]}},
    {"name": "subscribe: an after with a negative seq", "phase": "open",
     "send": [{"type": "req", "id": "1", "op": "subscribe", "params": {"session": "missing", "after": {"instance_id": "i1", "seq": -1}}}],
     "expect": {"frames": [{"type": "res", "id": "1", "ok": false, "error": {"code": "bad_params"}}]}},
    {"name": "unsubscribe", "phase": "open",
     "send": [{"type": "req", "id": "1", "op": "unsubscribe", "params": {"sub": "0"}}],
     "expect": {"frames": [{"type": "res", "id": "1", "ok": false, "error": {"code": "unknown_sub"}}]}},
    {"name": "unsubscribe: no sub", "phase": "open",
     "send": [{"type": "req", "id": "1", "op": "unsubscribe", "params": {}}],
     "expect": {"frames": [{"type": "res", "id": "1", "ok": false, "error": {"code": "bad_params"}}]}},
    {"name": "history", "phase": "open",
     "send": [{"type": "req", "id": "1", "op": "history", "params": {"session": "missing", "instance_id": "i1", "before": "m1", "limit": 1000}}],
     "expect": {"frames": [{"type": "res", "id": "1", "ok": false, "error": {"code": "session_not_found"}}]}},
    {"name": "history: no before", "phase": "open",
     "send": [{"type": "req", "id": "1", "op": "history", "params": {"session": "missing", "instance_id": "i1"}}],
     "expect": {"frames": [{"type": "res", "id": "1", "ok": false, "error": {"code": "bad_params"}}]}},
    {"name": "prompt with a product origin", "phase": "open",
     "send": [{"type": "req", "id": "1", "op": "prompt", "params": {"session": "missing", "text": "hi", "origin": {"kind": "product", "id": "bot"}}}],
     "expect": {"frames": [{"type": "res", "id": "1", "ok": false, "error": {"code": "session_not_found"}}]}},
    {"name": "prompt: an origin of another kind", "phase": "open",
     "send": [{"type": "req", "id": "1", "op": "prompt", "params": {"session": "missing", "text": "hi", "origin": {"kind": "user", "id": null}}}],
     "expect": {"frames": [{"type": "res", "id": "1", "ok": false, "error": {"code": "bad_params"}}]}},
    {"name": "prompt: a hook origin, which only the session makes", "phase": "open",
     "send": [{"type": "req", "id": "1", "op": "prompt", "params": {"session": "missing", "text": "hi", "origin": {"kind": "hook", "id": "Acme.Hook.Check"}}}],
     "expect": {"frames": [{"type": "res", "id": "1", "ok": false, "error": {"code": "bad_params"}}]}},
    {"name": "steer", "phase": "open",
     "send": [{"type": "req", "id": "1", "op": "steer", "params": {"session": "missing", "text": "hi"}}],
     "expect": {"frames": [{"type": "res", "id": "1", "ok": false, "error": {"code": "session_not_found"}}]}},
    {"name": "steer: a text that is not a string", "phase": "open",
     "send": [{"type": "req", "id": "1", "op": "steer", "params": {"session": "missing", "text": 1}}],
     "expect": {"frames": [{"type": "res", "id": "1", "ok": false, "error": {"code": "bad_params"}}]}},
    {"name": "follow_up", "phase": "open",
     "send": [{"type": "req", "id": "1", "op": "follow_up", "params": {"session": "missing", "text": "hi"}}],
     "expect": {"frames": [{"type": "res", "id": "1", "ok": false, "error": {"code": "session_not_found"}}]}},
    {"name": "follow_up: no text", "phase": "open",
     "send": [{"type": "req", "id": "1", "op": "follow_up", "params": {"session": "missing"}}],
     "expect": {"frames": [{"type": "res", "id": "1", "ok": false, "error": {"code": "bad_params"}}]}},
    {"name": "abort", "phase": "open",
     "send": [{"type": "req", "id": "1", "op": "abort", "params": {"session": "missing"}}],
     "expect": {"frames": [{"type": "res", "id": "1", "ok": false, "error": {"code": "session_not_found"}}]}},
    {"name": "abort: a session that is not a string", "phase": "open",
     "send": [{"type": "req", "id": "1", "op": "abort", "params": {"session": 1}}],
     "expect": {"frames": [{"type": "res", "id": "1", "ok": false, "error": {"code": "bad_params"}}]}},
    {"name": "set_model", "phase": "open",
     "send": [{"type": "req", "id": "1", "op": "set_model", "params": {"session": "missing", "model": "fake/echo"}}],
     "expect": {"frames": [{"type": "res", "id": "1", "ok": false, "error": {"code": "session_not_found"}}]}},
    {"name": "set_model: no model", "phase": "open",
     "send": [{"type": "req", "id": "1", "op": "set_model", "params": {"session": "missing"}}],
     "expect": {"frames": [{"type": "res", "id": "1", "ok": false, "error": {"code": "bad_params"}}]}},
    {"name": "compact", "phase": "open",
     "send": [{"type": "req", "id": "1", "op": "compact", "params": {"session": "missing"}}],
     "expect": {"frames": [{"type": "res", "id": "1", "ok": false, "error": {"code": "session_not_found"}}]}},
    {"name": "compact: a text that is not a string", "phase": "open",
     "send": [{"type": "req", "id": "1", "op": "compact", "params": {"session": "missing", "text": 5}}],
     "expect": {"frames": [{"type": "res", "id": "1", "ok": false, "error": {"code": "bad_params"}}]}},
    {"name": "stop", "phase": "open",
     "send": [{"type": "req", "id": "1", "op": "stop", "params": {"session": "missing"}}],
     "expect": {"frames": [{"type": "res", "id": "1", "ok": false, "error": {"code": "session_not_found"}}]}},
    {"name": "stop: no session", "phase": "open",
     "send": [{"type": "req", "id": "1", "op": "stop", "params": {}}],
     "expect": {"frames": [{"type": "res", "id": "1", "ok": false, "error": {"code": "bad_params"}}]}},
    {"name": "answer", "phase": "open",
     "send": [{"type": "req", "id": "1", "op": "answer", "params": {"session": "missing", "ask_id": "a1", "answer": {"choice": "yes"}}}],
     "expect": {"frames": [{"type": "res", "id": "1", "ok": false, "error": {"code": "session_not_found"}}]}},
    {"name": "answer: an answer that is not an object", "phase": "open",
     "send": [{"type": "req", "id": "1", "op": "answer", "params": {"session": "missing", "ask_id": "a1", "answer": "yes"}}],
     "expect": {"frames": [{"type": "res", "id": "1", "ok": false, "error": {"code": "bad_params"}}]}},

    {"name": "ack of a sub that the connection does not hold", "phase": "open",
     "send": [{"type": "ack", "sub": "9", "seq": 1},
              {"type": "req", "id": "1", "op": "sessions.live", "params": {}}],
     "expect": {"frames": [{"type": "res", "id": "1", "ok": true, "result": {"sessions": []}}]}},
    {"name": "ack: a negative seq", "phase": "open",
     "send": [{"type": "ack", "sub": "9", "seq": -1}],
     "expect": {"close": 4400}},
    {"name": "ack: a key that the frame does not name", "phase": "open",
     "send": [{"type": "ack", "sub": "9", "seq": 1, "x": 1}],
     "expect": {"close": 4400}},

    {"name": "part: a req in two parts, cut inside a UTF-8 character", "phase": "open",
     "send": [{"type": "part", "n": 0, "last": false, "data": "eyJ0eXBlIjoicmVxIiwiaWQiOiLD"},
              {"type": "part", "n": 1, "last": true, "data": "qSIsIm9wIjoic2Vzc2lvbnMubGl2ZSIsInBhcmFtcyI6e319"}],
     "expect": {"frames": [{"type": "res", "id": "é", "ok": true, "result": {"sessions": []}}]}},
    {"name": "part: out of order", "phase": "open",
     "send": [{"type": "part", "n": 1, "last": true, "data": "e30="}],
     "expect": {"close": 4400}},
    {"name": "part: data that is not base64", "phase": "open",
     "send": [{"type": "part", "n": 0, "last": true, "data": "!!"}],
     "expect": {"close": 4400}},
    {"name": "part: another frame between two parts", "phase": "open",
     "send": [{"type": "part", "n": 0, "last": false, "data": "eyJ0eXBlIjoicmVxIiwiaWQiOiLD"},
              {"type": "req", "id": "1", "op": "sessions.live", "params": {}}],
     "expect": {"close": 4400}}
  ]
}
